---
import Base from '../layouts/Base.astro';
import { site } from '../site';

// Edit these lists to update your CV.
const education = [
  { when: '2026–', what: 'Master’s program, Department of Landscape Architecture', where: 'Fu Jen Catholic University, Taipei · Admitted ranked 1st' },
  { when: '2022–26', what: 'Bachelor of Landscape Architecture', where: 'Fu Jen Catholic University, Taipei · GPA 3.9/4.0, ranked 1st of 35' },
];

const experience = [
  { when: '2026', what: 'Intern, AECOM Taiwan', note: 'Jul–Aug' },
  { when: '2025', what: 'Intern, dA VISION DESIGN', note: 'Jul–Aug' },
  { when: '2025', what: 'Part-time assistant, Takano Landscape Planning Taiwan', note: 'Jan–Feb' },
  { when: '2024', what: 'Intern, Takano Landscape Planning Taiwan', note: 'Jul–Aug' },
  { when: '2025–26', what: 'Convener, Graduation Exhibition Committee', note: 'Department of Landscape Architecture, Fu Jen' },
  { when: '2024–25', what: 'President, Landscape Architecture Student Association', note: 'Fu Jen Catholic University' },
];

const awardGroups = [
  {
    title: 'International',
    items: [
      { when: '2025', what: 'First Place Award, IFLA Global Studio Program', note: 'Overall ranking across Nantes, Santiago, Mumbai and Wuhan', href: '/works/ifla-global-studio-2025/' },
      { when: '2025', what: 'Honorary Award, IFLA Global Studio Program, Wuhan Charrette' },
      { when: '2025', what: 'Second Prize, IFLA Global Studio Program, Nantes Charrette' },
      { when: '2025', what: 'Second Prize, IFLA Global Studio Program, Mumbai Charrette' },
    ],
  },
  {
    title: 'National',
    items: [
      { when: '2026', what: 'Honorable Mention, 20th National Student Landscape Design Competition', note: 'After the Lagoon' },
      { when: '2025', what: '3rd Place, Embrace G.R.A.C.E Sustainability Expo Exhibition Design Competition' },
      { when: '2025', what: 'Outstanding Team, Human-Centred Streets Hackathon, university division' },
      { when: '2024', what: '1st Place, Fu Jen Catholic University Campus Sustainability and Circular Innovation Proposal Competition' },
      { when: '2024', what: '3rd Place, Yang Light Rail Youth Design Competition', note: 'Floating Green Nexus', href: '/works/floating-green-nexus/' },
      { when: '2024', what: 'Selected, EVA Air ESG Sustainable Innovation Design Competition', note: 'Green Rescue Station', href: '/works/green-rescue-station/' },
      { when: '2024', what: 'Honorable Mention, New Taipei City University Carbon Reduction Product Competition' },
    ],
  },
  {
    title: 'Academic',
    items: [
      { when: '2026', what: 'Member, Phi Tau Phi Scholastic Honor Society' },
      { when: '2022–26', what: 'Academic Excellence Award, ranked 1st, every year', note: 'Fu Jen Catholic University' },
      { when: '2022–25', what: 'Rao Wen-Zhong Memorial Award for Outstanding Design, 1st place', note: '3rd place in 2026' },
    ],
  },
];
---

<Base title="About" current="about">
  <div class="wrap">
    <div class="p-head">
      <div class="eyebrow mono"><span>{site.name} {site.nameZh}</span><span>{site.city}</span></div>
      <h1>About<span class="dot">.</span></h1>
    </div>

    <section class="about-grid">
      <h2 class="mono">Profile</h2>
      <div>
        <p class="lead">
          Sheng-En (Sean) Tsai is a graduate student in landscape architecture, working across natural and urban
          landscape planning and design.
        </p>
        <p>
          His projects deal with landscapes under pressure: a lagoon disappearing from Taiwan’s oyster coast, a polluted
          urban creek, a former landfill on the Keelung shore. He is interested in how local and traditional ecological
          knowledge can become working design mechanisms.
        </p>
        <p>
          In 2025 he earned four international awards in the IFLA Global Studio Program: First Place overall, Second Prize
          at the Nantes and Mumbai charrettes, and an Honorary Award in Wuhan. He also holds several national design
          competition awards, graduated first in his class (GPA 3.9/4.0) and ranked first in graduate admissions.
        </p>
        <p>
          He has interned at AECOM Taiwan and two Taiwan-based landscape planning and design firms, and has led teams as
          President of the department student association and Convener of the Graduation Exhibition Committee.
        </p>
      </div>
    </section>

    <section class="about-grid">
      <h2 class="mono">Education</h2>
      <ul class="cv">
        {education.map((e) => (
          <li><span class="when">{e.when}</span><span>{e.what}<small>{e.where}</small></span></li>
        ))}
      </ul>
    </section>

    <section class="about-grid">
      <h2 class="mono">Experience</h2>
      <ul class="cv">
        {experience.map((e) => (
          <li><span class="when">{e.when}</span><span>{e.what}{e.note && <small>{e.note}</small>}</span></li>
        ))}
      </ul>
    </section>

    {awardGroups.map((g, gi) => (
      <section class="about-grid">
        <h2 class="mono award-head">{gi === 0 ? 'Awards · ' : ''}{g.title}</h2>
        <ul class="cv">
          {g.items.map((a) => (
            <li><span class="when">{a.when}</span><span>{a.href ? <a href={a.href}>{a.what}</a> : a.what}{a.note && <small>{a.note}</small>}</span></li>
          ))}
        </ul>
      </section>
    ))}

    <section class="about-grid">
      <h2 class="mono">Contact</h2>
      <div>
        <p><a class="email" href={`mailto:${site.email}`}>{site.email}</a></p>
        <p>{site.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>)}</p>
      </div>
    </section>
  </div>
</Base>
