---
import '../styles/global.css';
import { site } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'works' | 'about';
}

const { title, description = site.description, image = '/og-default.jpg', current } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Mark that scripts run (enables scroll reveal) and play the intro only once per visit.
      document.documentElement.classList.add('js');
      try {
        if (sessionStorage.getItem('intro-seen')) document.documentElement.classList.add('intro-seen');
        else sessionStorage.setItem('intro-seen', '1');
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="site-intro" aria-hidden="true">
      <div class="site-intro-word">
        {[...site.wordmark].map((ch, i) => <span style={`animation-delay:${0.08 + i * 0.06}s`}>{ch}</span>)}<span class="dot" style={`animation-delay:${0.08 + site.wordmark.length * 0.06}s`}>.</span>
      </div>
    </div>
    <header class="nav">
      <div class="wrap">
        <a class="logo" href="/">{site.wordmark}<sup>LA</sup></a>
        <nav aria-label="Main">
          <ul>
            <li><a href="/#works" aria-current={current === 'works' ? 'page' : undefined}>Works</a></li>
            <li><a href="/about/" aria-current={current === 'about' ? 'page' : undefined}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <script is:inline>
      // Scroll reveal: each block fades up out of a blur the first time it enters the screen.
      (function () {
        if (!('IntersectionObserver' in window)) { document.documentElement.classList.remove('js'); return; }
        var sel = 'main h1, main h2, main h3, main h4, main p, main li, main dl > div, main figure, main .wide-section, main .feature, main .stats > div, main .tri > div, main .calendar, main .eyebrow, main .meta, main .credits, footer .wrap > div';
        var els = [];
        document.querySelectorAll(sel).forEach(function (el) {
          if (el.closest('.rv')) return; // a parent already animates
          el.classList.add('rv');
          if (el.matches('figure, .wide-section, .feature')) el.classList.add('rv-media');
          els.push(el);
        });
        var io = new IntersectionObserver(function (entries) {
          var batch = 0;
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            e.target.style.setProperty('--rv-delay', Math.min(batch++ * 0.07, 0.42) + 's');
            e.target.classList.add('in');
            io.unobserve(e.target);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0 });
        var start = function () { els.forEach(function (el) { io.observe(el); }); };
        // On the first visit, wait for the intro curtain to lift before revealing what's on screen.
        var introPlays = !document.documentElement.classList.contains('intro-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (introPlays) setTimeout(start, 1500); else start();
      })();
    </script>

    <footer>
      <div class="wrap">
        <div><span class="big">{site.wordmark}<span class="dot">.</span></span></div>
        <div>
          <h5 class="mono">Contact</h5>
          <p><a class="email" href={`mailto:${site.email}`}>{site.email}</a></p>
        </div>
        <div>
          <h5 class="mono">Elsewhere</h5>
          <ul>
            {site.links.map((l) => <li><a href={l.href} target="_blank" rel="noopener">{l.label}</a></li>)}
            <li class="mono" style="color:var(--muted);margin-top:8px">© {year} {site.name}</li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
